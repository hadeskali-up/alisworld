# Backend API key (must match pusher and Android app)
API_KEY=change-this-to-a-secure-random-key

# Timezone for daily PnL reset (e.g., Asia/Kuala_Lumpur for UTC+8)
TIMEZONE=Asia/Kuala_Lumpur

# SQLite database path
DATABASE_URL=sqlite:///./alisworld.db

# Firebase credentials for FCM notifications (download from Firebase Console)
# Path is relative to backend/ directory
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
